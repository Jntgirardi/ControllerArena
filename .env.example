# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - MODELO (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para um novo arquivo chamado '.env' no mesmo diretório.
# 2. Insira as credenciais reais e chaves de segurança adequadas para produção.
# 3. NUNCA commit o arquivo '.env' no seu controle de versão (Git). Ele já está
#    no arquivo '.gitignore' para sua total segurança física.
# ==============================================================================

# 1. Configuração do Flask
# IMPORTANTE: Em produção, defina FLASK_ENV=production para blindar o Werkzeug debugger
FLASK_ENV=development
SECRET_KEY=insira-sua-chave-criptografica-super-secreta-aqui

# 2. Configurações de Banco de Dados NoSQL (MongoDB)
# Insira a string de conexão segura. Ex para MongoDB Atlas ou local com autenticação:
# MONGO_URI=mongodb+srv://<usuario>:<senha>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=fps_arena

# 3. Configurações de Cache de Alta Performance (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=120
REDIS_ENABLED=true

# 4. Configurações de Cookies de Sessão (HTTPS)
# Defina como 'true' em produção (quando utilizar SSL/HTTPS) para garantir que cookies
# de sessão admin não sejam interceptados por conexões inseguras.
SESSION_COOKIE_SECURE=false
